# Server Configuration
PORT=5718
NODE_ENV=development

# Allowed Client Origin for CORS
CLIENT_URL=http://localhost:5173

# ---- Contact form email delivery ----
# The Gmail address the contact form will send FROM.
EMAIL_USER=your-gmail-address@gmail.com
# A Gmail "App Password" (NOT your normal Gmail password).
# Create one at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be enabled on the Google account.)
EMAIL_PASS=your-16-character-app-password
# The inbox that should actually receive messages (defaults to EMAIL_USER if omitted).
RECEIVER_EMAIL=harshakummetha78@gmail.com

# Optional: use a different SMTP provider instead of Gmail
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
